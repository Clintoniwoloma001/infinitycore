# Copy this file to .env and fill in real credentials. DO NOT commit .env to git.
# Supabase (public) — required for the client-side app to talk to Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: local development overrides
# VITE_OPENAI_PROXY_URL=http://localhost:3000/.netlify/functions/openai

# NOTE: Never put secret keys (like the OpenAI secret) in a client-visible env var.
# For OpenAI, create a server-side endpoint and store the secret in server-side environment variables.
